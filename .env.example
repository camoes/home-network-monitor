# Variables del stack. Copia a `.env` y ajusta:  cp .env.example .env
# `.env` está en .gitignore y nunca debe subirse al repositorio.

# Nombre del proyecto Compose (prefijo de contenedores y volúmenes)
COMPOSE_PROJECT_NAME=monitor-internet

# --- Grafana ---------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
# Obligatoria: el stack no arranca si falta.
GRAFANA_ADMIN_PASSWORD=change-this-before-starting
GRAFANA_ROOT_URL=http://localhost:3000

# --- Prometheus ------------------------------------------------------------
PROMETHEUS_RETENTION=30d

# --- Contrato del ISP (Mbps del plan, para comparar con lo medido) ---------
ISP_DOWNLOAD_MBPS=1000
ISP_UPLOAD_MBPS=1000

# --- DNS / AdGuard Home ----------------------------------------------------
# AdGuard en el host: DNS en 53, API en 80.
ADGUARD_URL=http://host.docker.internal:80
# ip-api envía IPs de destino a un tercero; pon "off" para no salir nunca.
GEOIP_API=ip-api
DNS_MAP_POLL_SECONDS=60

# --- Captura de paquetes (perfil "capture", solo Linux) --------------------
CAPTURE_IFACE=eth0
