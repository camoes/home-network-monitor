    {
      "type": "table",
      "title": "Dispositivos: consultas, bloqueos y telemetría",
      "description": "Una fila por equipo. “Sin DNS” = 1 significa que no usa AdGuard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "netviz_device_queries_total{device!~\"lwip0|DEV\\\\.WIFI\\\\.AP.*|LAN.*\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "netviz_device_blocked_total{device!~\"lwip0|DEV\\\\.WIFI\\\\.AP.*|LAN.*\"}",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "netviz_device_tracker_total{device!~\"lwip0|DEV\\\\.WIFI\\\\.AP.*|LAN.*\"}",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "netviz_device_silent{device!~\"lwip0|DEV\\\\.WIFI\\\\.AP.*|LAN.*\"}",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": []
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": [
              "device",
              "ip"
            ],
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "netviz_device_queries_total": "Consultas",
              "netviz_device_blocked_total": "Bloqueadas",
              "netviz_device_tracker_total": "Telemetría",
              "netviz_device_silent": "Sin DNS"
            },
            "indexByName": {
              "device": 0,
              "ip": 1,
              "type": 2,
              "network": 3,
              "Consultas": 4,
              "Bloqueadas": 5,
              "Telemetría": 6,
              "Sin DNS": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Consultas",
                "desc": true
              }
            ],
            "fields": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Consultas",
            "desc": true
          }
        ]
      }
    },
